# --- The single real mailbox you bought (GoDaddy Workspace / Professional Email) ---
MAIL_USER=abc@abc.com
MAIL_PASSWORD=your-mailbox-password

# Optional: use the PHP IMAP/SMTP bridge when this Node.js host blocks mail ports.
# Deploy php-mail-bridge/index.php to HTTPS on a host that permits IMAP and SMTP, then set:
# MAIL_BRIDGE_URL=https://api.example.com/aliasmail-bridge/index.php
# MAIL_BRIDGE_TOKEN=long-random-shared-secret
# Keep MAIL_USER set on this app for the admin identity. Put MAIL_PASSWORD only on the PHP host.

# GoDaddy Workspace / Professional Email defaults.
# For "Microsoft 365 from GoDaddy" use IMAP_HOST=outlook.office365.com and
# SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
# GoDaddy shared (cPanel) hosting may block outgoing SMTP. If "Test connection" fails on SMTP
# there, use the local relay instead: SMTP_HOST=localhost, SMTP_PORT=25, SMTP_SECURE=false,
# SMTP_AUTH=false
SMTP_AUTH=true

# --- Admin panel login (defaults ADMIN_EMAIL to MAIL_USER) ---
ADMIN_EMAIL=abc@abc.com
ADMIN_PASSWORD=change-this-admin-password

# --- App ---
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
SYNC_INTERVAL_SECONDS=60
# While someone has AliasMail open, the INBOX is checked this often so new mail appears within
# seconds (minimum 5). With nobody watching, only the SYNC_INTERVAL_SECONDS sync runs.
LIVE_SYNC_SECONDS=10
DATA_FILE=data/db.json

# --- Database (recommended when hosting) ---
# Hosts that rebuild the app from git (GoDaddy Node.js hosting) wipe data/db.json and uploaded
# pictures on every deploy. Set DATABASE_URL to keep everything in MySQL or PostgreSQL instead.
# Tables are created on first start, and an existing data/db.json is copied in.
# DATABASE_URL=mysql://user:password@host:3306/aliasmail
# DATABASE_URL=postgres://user:password@host:5432/aliasmail
# Set true if the database requires an encrypted (SSL) connection.
DATABASE_SSL=false

# --- Sign-in security ---
# Sessions end after SESSION_DAYS, or after SESSION_IDLE_HOURS without use.
SESSION_DAYS=7
SESSION_IDLE_HOURS=24
# "Don't ask again on this device" skips the Google Authenticator code for this many days.
MFA_TRUST_DAYS=30
# Live site (see "Going live on GoDaddy" in README.md): NODE_ENV=production, COOKIE_SECURE=true,
# TRUST_PROXY=true. FORCE_HTTPS redirects http -> https inside the app; on cPanel prefer
# Domains -> "Force HTTPS Redirect" instead and leave this false.
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
FORCE_HTTPS=false
# Note: authenticator secrets are encrypted with a key derived from JWT_SECRET. Don't change
# JWT_SECRET once people use 2-Step Verification: their codes would stop working until the
# admin resets 2-step for each of them (Admin console → Aliases → Reset).

# --- Mail performance ---
# Keep bridge on hosting that blocks outbound IMAP. No Node mailbox password is
# required for bridge mode. Direct/auto modes are optional for a VPS or other host
# that permits persistent IMAP connections and has MAIL_PASSWORD configured.
MAIL_TRANSPORT=bridge
# Direct mode: persistent foreground + background INBOX/IDLE sessions.
# MAIL_TRANSPORT=direct
# Auto mode: try direct; use bridge for five minutes if connection fails.
# MAIL_TRANSPORT=auto
MESSAGE_CACHE_ENABLED=true
MESSAGE_CACHE_MB=250
MESSAGE_CACHE_DAYS=30
# Cached raw mail (including attachments up to 5 MB per message) is encrypted
# using JWT_SECRET. Keep that secret stable. DATABASE_URL makes the cache survive
# rebuilds; otherwise it is saved under the DATA_FILE directory (mail-cache/).

# In production, DATABASE_URL is required unless a persistent disk is explicitly used.
# Set DATABASE_URL in the hosting dashboard, not in source code or a deployment ZIP.
# Keep the SAME database and JWT_SECRET on every deployment.
# ALLOW_FILE_STORAGE=true  # Only with DATA_FILE on a persistent volume, not a build folder.

# --- Sign-in locations ---
# "Where you're signed in" and the admin activity log show an approximate city/country for each
# sign-in IP, looked up once per IP per day at ipapi.co (the visitor's IP is sent there; private
# addresses never are). Set IP_LOCATION=off to turn this off.
IP_LOCATION=on
