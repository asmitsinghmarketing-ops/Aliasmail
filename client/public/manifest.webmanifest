{
  "id": "/",
  "name": "Nextspace",
  "short_name": "Nextspace",
  "description": "Your email, wherever you go.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "categories": ["productivity", "business", "email"],
  "shortcuts": [
    { "name": "Inbox", "short_name": "Inbox", "url": "/?folder=inbox", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compose", "short_name": "Compose", "url": "/?compose=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
